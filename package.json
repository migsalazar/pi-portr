{
  "name": "pi-portr",
  "version": "0.1.2",
  "description": "Hand off work and ask questions across visible, independent agent sessions.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/migsalazar/pi-portr.git"
  },
  "homepage": "https://github.com/migsalazar/pi-portr#readme",
  "bugs": {
    "url": "https://github.com/migsalazar/pi-portr/issues"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "herdr",
    "agents",
    "handoff"
  ],
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test --experimental-strip-types tests/*.test.ts tests/*.test.mjs",
    "test:integration": "node --test --experimental-strip-types tests/integration/*.test.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint src scripts tests",
    "format": "biome format --write src scripts tests package.json tsconfig.json biome.json",
    "format:check": "biome format src scripts tests package.json tsconfig.json biome.json",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test",
    "release": "node scripts/release.mjs"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ],
    "video": "https://raw.githubusercontent.com/migsalazar/pi-portr/main/assets/pi-portr-demo-0.1.mp4"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.9",
    "@earendil-works/pi-coding-agent": "0.84.3",
    "@types/node": "22.20.1",
    "typescript": "7.0.2"
  }
}
